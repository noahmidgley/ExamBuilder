# Copy this file to .env and fill in the values.
# .env is listed in .gitignore so it is never committed.

# Long random string used to sign session cookies.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Login details. Never store the plain password - store the hash.
# Generate the hash with:  python3 scripts/setup_env.py
LOGIN_USERNAME=
LOGIN_PASSWORD_HASH=

# Claude API key (used by the importer to tag topics in Stage 3)
ANTHROPIC_API_KEY=

# Optional: where data lives. Defaults to folders inside the project.
# On Render these will point at the persistent disk (Stage 6).
# DATA_DIR=

# "I'm interested" form notifications (https://resend.com - free plan is fine).
# Without these, submissions are still saved and shown on the Settings page.
RESEND_API_KEY=
NOTIFY_EMAIL=
